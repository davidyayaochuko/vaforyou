# Copy to .env — or just run `npm run setup`, which writes this file for you.

# ── The AI layer ──────────────────────────────────────────────────────────────
# One free key is all this needs. Get it at https://console.groq.com/keys —
# no card, takes about a minute. The free tier is what the whole engine is
# designed around: these are two-hundred-word posts written against a template
# that already dictates their shape, so a frontier model buys nothing here.
GROQ_API_KEY=
# Groq retires model ids regularly. Setup checks this against the live catalogue
# and replaces it if it has gone; `npm run doctor` re-checks it later.
GROQ_MODEL=openai/gpt-oss-120b
# Mic transcription (Groq Whisper). Audio is sent to Groq, then discarded.
# STT_PROVIDER=auto|groq|browser  (auto uses Groq when GROQ_API_KEY is set)
STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional Azure Neural TTS (Nigerian English). Browser en-NG is the default when
# your OS/browser provides Abeo/Ezinne. Text leaves the machine only if you set these.
# Free F0 is typically 500k characters/month; confirm on your Azure SKU.
# TTS_PROVIDER=auto|browser|azure
TTS_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-NG-EzinneNeural

# Paid lane, entirely optional. Anthropic is used ONLY when both of these are
# set — a key sitting in this file is not consent to spend it.
ANTHROPIC_API_KEY=
AI_PAID=false
AI_MODEL=claude-opus-5

# With no key at all the engine runs a deterministic mock: every step works, but
# generated posts are always `blocked` by the content gate, on purpose, so stub
# text can never reach a real account.

# ── The machine ───────────────────────────────────────────────────────────────
# Where the SQLite database lives.
DB_PATH=./data/pilot.db

# Where each account's persistent Chromium profile lives. One directory per
# account. Treat these like credentials — they hold the logged-in session.
PROFILES_DIR=./data/profiles

# HTTP control API + dashboard.
PORT=4310
# Loopback by default. Binding elsewhere requires BOTH:
#   BIND_ALLOW_NON_LOOPBACK=true
#   and a non-empty API_TOKEN
# Otherwise the process refuses to start.
BIND_HOST=127.0.0.1
BIND_ALLOW_NON_LOOPBACK=false
# Required as `Authorization: Bearer <token>` on every /api call. `npm run setup`
# generates one. Leave blank ONLY if you are on loopback on a machine nobody else can reach.
API_TOKEN=

# High-risk features. Leave false unless you explicitly want them.
# Outreach = LinkedIn invite/message funnel. Engage = likes/comments on others' posts.
OUTREACH_ENABLED=false
ENGAGE_FEED_ENABLED=false
# Workspace MCP write tools (send email, create/delete files). Stay false until
# the approval queue can gate them. Read tools still work when MCP is configured.
WORKSPACE_MCP_WRITES=false

# Set to 1 to run the browser headless. Default is headed: LinkedIn is markedly
# more suspicious of headless sessions, and you want to see what it is doing.
HEADLESS=0

# Global kill switch. Set to 1 and the scheduler refuses to run any action.
PAUSED=0

# ── Personal VA (Ask box, calendar, reminders) ────────────────────────────────
# IANA timezone for your calendar confirmations (e.g. Africa/Lagos).
HOME_TIMEZONE=Africa/Lagos
# Local hour (0-23) in HOME_TIMEZONE for the daily digest. Default 8.
DAILY_SUMMARY_HOUR=8

# Where reminder emails go. Leave blank to keep reminders local-only.
NOTIFY_EMAIL=

# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
# Use an App Password, not your normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional From line. Defaults to SMTP_USER.
SMTP_FROM=

# Google Calendar SSO (OAuth). Create a Desktop or Web client in Google Cloud,
# enable Calendar API, and set redirect URI to:
#   http://127.0.0.1:4310/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Workspace via an open-source MCP server (Gmail, Calendar, Drive, Docs, People).
# Recommended: https://github.com/taylorwilsdon/google_workspace_mcp
#   WORKSPACE_MCP_COMMAND=uvx
#   WORKSPACE_MCP_ARGS=workspace-mcp
# Leave blank to keep Funke's local calendar only.
WORKSPACE_MCP_COMMAND=
WORKSPACE_MCP_ARGS=
