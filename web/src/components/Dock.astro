---
import Icon from './Icon.astro';
import { iconFaces, type IconName } from '../lib/icons';
import type { DockKey } from '../lib/dock';

interface Props {
  active?: DockKey | null;
}
const { active = null } = Astro.props;

const items: {
  key: DockKey;
  label: string;
  icon: IconName;
  hint: string;
}[] = [
  {
    key: 'apps',
    label: 'Apps',
    icon: 'apps',
    hint: 'Everything Funke can do (Ctrl/⌘ 1)',
  },
  {
    key: 'chat',
    label: 'Chat',
    icon: 'chat',
    hint: 'Ask Funke in plain English (Ctrl/⌘ K)',
  },
  {
    key: 'calendar',
    label: 'Calendar',
    icon: 'calendar',
    hint: 'Your upcoming events (Ctrl/⌘ 3)',
  },
  {
    key: 'approvals',
    label: 'Approvals',
    icon: 'approvals',
    hint: 'Drafts waiting for your yes (Ctrl/⌘ 4)',
  },
];
---
<div class="dock-wrap">
  <nav aria-label="App dock" class="dock" id="dockShell">
    {
      items.map((item) => {
        const face = iconFaces[item.key] ?? iconFaces.funke!;
        return (
          <button
            type="button"
            class:list={['dock-item', active === item.key && 'is-open']}
            data-dock={item.key}
            aria-label={item.label}
            title={item.hint}
            aria-current={active === item.key ? 'true' : undefined}
          >
            <span class="dock-tip">{item.label}</span>
            <span
              class="dock-icon icon-tile"
              style={`background: linear-gradient(160deg, ${face.from} 0%, ${face.to} 100%)`}
            >
              <span class="icon-tile-sheen" aria-hidden="true" />
              <span class="dock-glyph">
                <Icon name={item.icon} size={24} />
              </span>
            </span>
            {item.key === 'approvals' ? <span class="dock-badge" data-approvals-badge hidden /> : null}
            <span class="dock-dot" aria-hidden="true" />
          </button>
        );
      })
    }
  </nav>
</div>
<script>
  const badge = document.querySelector<HTMLElement>('[data-approvals-badge]');
  const refreshBadge = async () => {
    if (!badge) return;
    try {
      const res = await fetch('/api/approvals');
      if (!res.ok) throw new Error(String(res.status));
      const rows = (await res.json()) as unknown[];
      const n = Array.isArray(rows) ? rows.length : 0;
      badge.textContent = n > 9 ? '9+' : String(n);
      badge.hidden = n === 0;
      badge.closest('.dock-item')?.setAttribute('aria-label', n ? `Approvals, ${n} waiting` : 'Approvals');
    } catch {
      badge.hidden = true;
    }
  };
  void refreshBadge();
  window.setInterval(refreshBadge, 30_000);
  window.addEventListener('funke:approvals-changed', () => void refreshBadge());

  const shell = document.getElementById('dockShell');
  if (!shell) {
    // no-op
  } else if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    shell.classList.add('dock--static');
  } else {
    const items = [...shell.querySelectorAll<HTMLElement>('.dock-item')];
    let centers: number[] = [];
    let shellLeft = 0;
    let raf = 0;
    let pendingX = 0;
    let active = false;

    const maxScale = 1.34;
    const range = 72;
    const maxLift = 12;

    const measure = () => {
      const shellRect = shell.getBoundingClientRect();
      shellLeft = shellRect.left;
      centers = items.map((el) => {
        const r = el.getBoundingClientRect();
        return r.left + r.width / 2 - shellLeft;
      });
    };

    const apply = (x: number) => {
      let best = -1;
      let bestW = 0;

      items.forEach((el, i) => {
        const cx = centers[i] ?? 0;
        const d = Math.abs(x - cx);
        const t = Math.max(0, 1 - d / range);
        const w = t <= 0 ? 0 : 0.5 - 0.5 * Math.cos(t * Math.PI);
        const s = 1 + (maxScale - 1) * w;
        const lift = maxLift * w;

        el.style.setProperty('--dock-scale', s.toFixed(4));
        el.style.setProperty('--dock-lift', `${lift.toFixed(2)}px`);
        el.style.zIndex = w > 0.02 ? String(Math.round(20 + w * 30)) : '';

        if (w > bestW) {
          bestW = w;
          best = i;
        }
      });

      items.forEach((el, i) => {
        el.classList.toggle('is-hot', i === best && bestW > 0.35);
      });
    };

    const reset = () => {
      active = false;
      shell.classList.remove('is-magnifying');
      items.forEach((el) => {
        el.style.setProperty('--dock-scale', '1');
        el.style.setProperty('--dock-lift', '0px');
        el.style.zIndex = '';
        el.classList.remove('is-hot');
      });
    };

    const onMove = (e: PointerEvent) => {
      pendingX = e.clientX - shellLeft;
      if (!raf) {
        raf = requestAnimationFrame(() => {
          raf = 0;
          if (active) apply(pendingX);
        });
      }
    };

    const onEnter = () => {
      measure();
      active = true;
      shell.classList.add('is-magnifying');
    };

    shell.addEventListener('pointerenter', onEnter);
    shell.addEventListener('pointermove', onMove);
    shell.addEventListener('pointerleave', reset);
    window.addEventListener('resize', measure);

    measure();
  }
</script>
