---
import { icons, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  fill-rule="evenodd"
  aria-hidden="true"
  class={cls}><path d={icons[name]}></path></svg>
