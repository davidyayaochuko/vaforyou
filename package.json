{
  "name": "vaforyou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Funke is a self-hosted personal VA. Manages LinkedIn and X from a browser you are logged into, plus calendar, reminders, and follow-ups with timezone-aware scheduling and Google Calendar SSO. No SaaS; free LLM tier; runs on your machine.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup-web.ts",
    "setup:cli": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "login": "tsx scripts/login.ts",
    "campaign": "tsx scripts/campaign.ts",
    "leads": "tsx scripts/leads.ts",
    "schedule": "tsx scripts/schedule.ts",
    "accounts": "tsx scripts/accounts.ts",
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "ui": "npm run dev --prefix web",
    "ui:build": "npm run build --prefix web",
    "ui:check": "npm run check --prefix web",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "va:eval": "tsx scripts/va-eval.ts",
    "guardrails": "tsx scripts/guardrails-smoke.ts",
    "usage:regression": "tsx scripts/usage-regression.ts",
    "phase0b": "tsx scripts/phase0b-smoke.ts",
    "voice:smoke": "tsx scripts/voice-smoke.ts",
    "launch:smoke": "tsx scripts/launch-smoke.ts",
    "conversations:smoke": "tsx scripts/conversations-smoke.ts",
    "selftest": "tsx scripts/selftest.ts",
    "draft": "tsx scripts/write.ts",
    "queue": "tsx scripts/write.ts",
    "publish": "tsx scripts/write.ts",
    "postinstall": "playwright install chromium",
    "login:all": "tsx scripts/login-all.ts",
    "whoami": "tsx scripts/whoami.ts",
    "unlock:x": "tsx scripts/unlock-x.ts",
    "rail": "tsx scripts/rail.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "googleapis": "^186.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.7",
    "playwright": "^1.50.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
